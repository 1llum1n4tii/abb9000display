
#!/bin/zsh

# Find display.py beside this wrapper.
SCRIPT_DIR="${0:A:h}"
DISPLAY_PY="$SCRIPT_DIR/display.py"
LOG_FILE="/tmp/display.log"

# Stop a process gracefully and wait for GPIO cleanup.
stop_pid() {
    local pid="$1"

    if ! kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    print -u2 -- "Stopping display process $pid..."
    kill -TERM "$pid" || return 1

    # Wait up to 5 seconds for graceful shutdown.
    local i
    for i in {1..50}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 0.1
    done

    print -u2 -- "ERROR: PID $pid did not exit within 5 seconds."
    print -u2 -- "Not sending SIGKILL, to allow GPIO cleanup."
    return 1
}

# Explicit stop mode: ./display.zsh --killpid PID
if [[ "$1" == "--killpid" ]]; then
    if [[ "$#" -ne 2 || ! "$2" =~ '^[0-9]+$' || "$2" -le 1 ]]; then
        print -u2 -- "Usage: $0 --killpid PID"
        exit 2
    fi

    PID="$2"

    # Verify that this PID belongs to a Python display.py process.
    CMD="$(ps -p "$PID" -o args= 2>/dev/null)"

    if [[ "$CMD" != *display.py* || "$CMD" != *python* ]]; then
        print -u2 -- "ERROR: PID $PID is not a Python display.py process."
        exit 1
    fi

    stop_pid "$PID" || exit 1
    print -u2 -- "Display process stopped."
    exit 0
fi

# Require display.py to exist.
if [[ ! -f "$DISPLAY_PY" ]]; then
    print -u2 -- "ERROR: Cannot find $DISPLAY_PY"
    exit 1
fi

# Stop any existing Python display.py instances before restarting.
# pgrep's bracket pattern avoids matching the search command itself.
OLD_PIDS=("${(@f)$(pgrep -f '[p]ython.*display\.py')}")

for PID in "${OLD_PIDS[@]}"; do
    [[ -z "$PID" ]] && continue
    stop_pid "$PID" || exit 1
done

# Start the new display in the background.
# The log file keeps Python output separate from the PID on stdout.
nohup python3 "$DISPLAY_PY" "$@" >"$LOG_FILE" 2>&1 </dev/null &
NEW_PID=$!

# Confirm the process started.
sleep 0.2

if ! kill -0 "$NEW_PID" 2>/dev/null; then
    print -u2 -- "ERROR: display.py failed to start."
    print -u2 -- "Check $LOG_FILE for details."
    exit 1
fi

print -u2 -- "Display started. Logs: $LOG_FILE"

# Print ONLY the PID to stdout, for easy capture by other scripts.
print -r -- "$NEW_PID"

