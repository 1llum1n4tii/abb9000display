
#!/bin/zsh

# Find displaypattern.py beside this wrapper.
SCRIPT_DIR="${0:A:h}"
DISPLAY_PY="$SCRIPT_DIR/displaypattern.py"
LOG_FILE="/tmp/displaypattern.log"

stop_pid() {
    local pid="$1"

    if ! kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    print -u2 -- "Stopping animation process $pid..."
    kill -TERM "$pid" || return 1

    # Wait up to 5 seconds for graceful GPIO cleanup.
    local i
    for i in {1..50}; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 0.1
    done

    print -u2 -- "ERROR: PID $pid did not exit within 5 seconds."
    print -u2 -- "Not sending SIGKILL."
    return 1
}

# Explicit stop mode.
if [[ "$1" == "--killpid" ]]; then
    if [[ "$#" -ne 2 || ! "$2" =~ '^[0-9]+$' || "$2" -le 1 ]]; then
        print -u2 -- "Usage: $0 --killpid PID"
        exit 2
    fi

    PID="$2"
    CMD="$(ps -p "$PID" -o args= 2>/dev/null)"

    if [[ "$CMD" != *displaypattern.py* || "$CMD" != *python* ]]; then
        print -u2 -- "ERROR: PID $PID is not a displaypattern.py process."
        exit 1
    fi

    stop_pid "$PID" || exit 1
    print -u2 -- "Animation stopped."
    exit 0
fi

if [[ ! -f "$DISPLAY_PY" ]]; then
    print -u2 -- "ERROR: Cannot find $DISPLAY_PY"
    exit 1
fi

# Stop existing animation processes before starting another.
OLD_PIDS=("${(@f)$(pgrep -f '[p]ython.*displaypattern\.py')}")

for PID in "${OLD_PIDS[@]}"; do
    [[ -z "$PID" ]] && continue
    stop_pid "$PID" || exit 1
done

# Start the requested animation.
nohup python3 "$DISPLAY_PY" "$@" >"$LOG_FILE" 2>&1 </dev/null &
NEW_PID=$!

sleep 0.2

if ! kill -0 "$NEW_PID" 2>/dev/null; then
    print -u2 -- "ERROR: Animation failed to start."
    print -u2 -- "Check $LOG_FILE for details."
    exit 1
fi

print -u2 -- "Animation started. Logs: $LOG_FILE"

# PID only on stdout, allowing PID=$(...) usage.
print -r -- "$NEW_PID"

