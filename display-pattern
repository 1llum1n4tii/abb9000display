
#!/usr/bin/env zsh

# Find displaypattern.py beside this wrapper.
SCRIPT_DIR="${0:A:h}"
DISPLAY_PY="$SCRIPT_DIR/displaypattern.py"
LOG_FILE="/tmp/displaypattern.log"

stop_pid() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null || return 0

    print -- "Stopping animation process $pid..."
    kill -TERM "$pid" 2>/dev/null || true

    local i
    for i in {1..5}; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done

    print -u2 -- "PID $pid did not exit after SIGTERM; trying SIGINT."
    kill -INT "$pid" 2>/dev/null || true

    for i in {1..3}; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done

    print -u2 -- "ERROR: PID $pid did not exit. Not sending SIGKILL."
    return 1
}

# Explicit stop mode: stop every matching animation process.
if [[ "$1" == "--killall" ]]; then
    if [[ "$#" -ne 1 ]]; then
        print -u2 -- "Usage: $0 --killall"
        exit 2
    fi

    PIDS=("${(@f)$(pgrep -f '[p]ython.*displaypattern\.py' || true)}")
    failed=0

    for PID in "${PIDS[@]}"; do
        [[ -z "$PID" ]] && continue
        stop_pid "$PID" || failed=1
    done

    if (( failed )); then
        print -u2 -- "ERROR: One or more animation processes failed to stop."
        exit 1
    fi
    exit 0
    exit 0
fi

if [[ ! -f "$DISPLAY_PY" ]]; then
    print -u2 -- "ERROR: Cannot find $DISPLAY_PY"
    exit 1
fi

# Stop existing animation processes before starting another.
OLD_PIDS=("${(@f)$(pgrep -f '[p]ython.*displaypattern\.py')}")

for PID in "${OLD_PIDS[@]}"; do
    [[ -z "$PID" ]] && continue
    stop_pid "$PID" || exit 1
done

# Start the requested animation.
nohup python3 "$DISPLAY_PY" "$@" >"$LOG_FILE" 2>&1 </dev/null &
NEW_PID=$!

sleep 0.2

if ! kill -0 "$NEW_PID" 2>/dev/null; then
    print -u2 -- "ERROR: Animation failed to start."
    print -u2 -- "Check $LOG_FILE for details."
    exit 1
fi

print -u2 -- "Animation started. Logs: $LOG_FILE"

# PID only on stdout, allowing PID=$(...) usage.
print -r -- "$NEW_PID"

